<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>宠物海报生成器</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cute: '#FFE6E6',
                        simple: '#F5F7FA',
                        cool: '#2A2A2A',
                    },
                    fontFamily: {
                        cute: ['cursive'],
                        simple: ['sans-serif'],
                        cool: ['sans-serif']
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .poster-shadow { box-shadow: 0 8px 30px rgba(0,0,0,0.15); }
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen pb-10">
    <header class="bg-white py-4 px-5 shadow-sm">
        <h1 class="text-center text-lg font-bold text-gray-800">🐾 宠物海报生成器</h1>
        <p class="text-gray-500 text-center text-xs mt-1">微信内可直接保存</p>
    </header>

    <div class="max-w-xl mx-auto px-5 mt-5">
        <div class="bg-white rounded-2xl p-5 shadow mb-5">
            <div class="mb-4">
                <label class="text-sm font-medium block mb-2">选择风格</label>
                <div class="flex gap-2">
                    <button id="cute" class="px-3 py-1.5 rounded-full bg-cute text-pink-700 border-2 border-white">可爱风</button>
                    <button id="simple" class="px-3 py-1.5 rounded-full bg-simple text-gray-700">简约风</button>
                    <button id="cool" class="px-3 py-1.5 rounded-full bg-cool text-white">潮酷风</button>
                </div>
            </div>

            <div class="space-y-3 mb-4">
                <div>
                    <label class="text-xs">上传宠物照片</label>
                    <input type="file" id="avatarUpload" accept="image/*" class="w-full border rounded-lg p-2 text-sm">
                </div>
                <input type="text" id="petId" placeholder="宠物ID" class="w-full border rounded-lg p-2 text-sm">
                <input type="text" id="petName" placeholder="宠物名字" class="w-full border rounded-lg p-2 text-sm">
                <textarea id="petDesc" placeholder="宠物宣言" rows="2" class="w-full border rounded-lg p-2 text-sm"></textarea>
            </div>

            <button id="generate" class="w-full bg-purple-500 text-white py-3 rounded-xl font-bold">生成海报</button>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow flex justify-center">
            <div id="poster" class="w-[300px] h-[400px] rounded-xl overflow-hidden relative">
                <div id="posterContent" class="w-full h-full bg-cute p-5 flex flex-col items-center justify-center text-center">
                    <img id="posterAvatar" src="https://picsum.photos/300/300" class="w-32 h-32 rounded-full object-cover border-4 border-white mb-3">
                    <p id="posterId" class="text-pink-700 text-sm">ID：未设置</p>
                    <h3 id="posterName" class="text-xl font-bold text-pink-800 my-1">毛孩子</h3>
                    <p id="posterDesc" class="text-gray-600 text-xs mt-1">快来写我的宣言～</p>
                </div>
            </div>
        </div>

        <button id="save" class="w-full bg-green-500 text-white py-3 rounded-xl font-bold mt-5">长按保存海报</button>
    </div>

    <script>
        let currentStyle = 'cute';
        const posterContent = document.getElementById('posterContent');
        const avatar = document.getElementById('posterAvatar');

        document.getElementById('cute').onclick = () => {
            currentStyle = 'cute';
            posterContent.className = 'w-full h-full bg-cute p-5 flex flex-col items-center justify-center text-center';
        }
        document.getElementById('simple').onclick = () => {
            currentStyle = 'simple';
            posterContent.className = 'w-full h-full bg-simple p-5 flex flex-col items-center justify-center text-center';
        }
        document.getElementById('cool').onclick = () => {
            currentStyle = 'cool';
            posterContent.className = 'w-full h-full bg-cool p-5 flex flex-col items-center justify-center text-center text-white';
        }

        document.getElementById('avatarUpload').onchange = (e) => {
            const file = e.target.files[0];
            if(file) {
                const reader = new FileReader();
                reader.onload = (ev) => avatar.src = ev.target.result;
                reader.readAsDataURL(file);
            }
        }

        document.getElementById('petId').oninput = () => {
            document.getElementById('posterId').innerText = "ID：" + document.getElementById('petId').value;
        }
        document.getElementById('petName').oninput = () => {
            document.getElementById('posterName').innerText = document.getElementById('petName').value;
        }
        document.getElementById('petDesc').oninput = () => {
            document.getElementById('posterDesc').innerText = document.getElementById('petDesc').value;
        }

        document.getElementById('generate').onclick = async () => {
            alert("生成成功！长按下方按钮保存图片");
        };

        document.getElementById('save').onclick = async () => {
            const canvas = await html2canvas(document.getElementById('poster'), {
                useCORS: true,
                scale: 2
            });
            const img = canvas.toDataURL('image/png');
            const imgDom = new Image();
            imgDom.src = img;
            imgDom.style.width = '100%';
            imgDom.style.position = 'fixed';
            imgDom.style.top = '0';
            imgDom.style.left = '0';
            imgDom.style.zIndex = '9999';
            document.body.appendChild(imgDom);
            alert("点击图片长按保存到手机！");
        };
    </script>
</body>
</html>
